<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#resume.basics}}{{name}}{{else}}Resume{{/resume.basics}}</title>
    <style>
      {{{css}}}
    </style>
  </head>
  <body>
    <div id="resume">
      {{> basics }}
      <div id="layout">
        <aside id="sidebar">
          {{> skills }}
          {{> languages }}
          {{> certificates }}
          {{> interests }}
        </aside>
        <main id="main">
          {{> work }}
          {{> projects }}
          {{> volunteer }}
          {{> education }}
          {{> awards }}
          {{> publications }}
          {{> references }}
        </main>
      </div>
    </div>
  </body>
</html>
