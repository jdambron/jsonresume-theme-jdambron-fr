{{#if resume.languages.length}}
<section class="section">
  <header>
    <h2 class='section-title'>Langues <span class="item-count">({{resume.languages.length}})</span></h2>
  </header>
  <section id="languages">
    {{#each resume.languages}}
    <div class="display">
      {{#if language}}<h3 class="language">{{language}}</h3>{{/if}}
      {{#if fluency}}<span class="fluency-label">{{#if fluencyDisplay}}{{fluencyDisplay}}{{else}}{{fluency}}{{/if}}</span>{{/if}}
    </div>
    {{/each}}
  </section>
</section>
{{/if}}
